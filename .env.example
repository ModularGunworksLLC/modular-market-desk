# ---------------------------------------------------------------------------
# Modular Market Desk - environment
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# Local SQLite file via @libsql/client. Lives on the persistent Lightsail disk.
# Relative paths are resolved from the app's working directory.
DATABASE_URL="file:./data/desk.db"

# Optional: only set when pointing DATABASE_URL at a remote Turso/libsql endpoint.
# DATABASE_AUTH_TOKEN=""

# GunBroker Analytics (Outdoor Analytics) portal API base.
GBA_API_BASE="https://api.gunbrokeranalytics.com/gba-portal-api"

# 2nd Amendment Wholesale dealer CSV feed URL (optional if stored in Session Vault meta).
# Use {token} in the URL if 2AW issued a templated link.
TAW_FEED_URL=""

# Chattanooga Shooting Supplies dealer REST API (same creds as modular-gunworks-site).
# Prefer Session Vault (vendor=chattanooga); env works as Lightsail fallback.
# CHATTANOOGA_API_SID=""
# CHATTANOOGA_API_TOKEN=""
# Optional aliases used by the website sync scripts:
# API_SID=""
# API_TOKEN=""
# CHATTANOOGA_API_BASE="https://api.chattanoogashooting.com/rest/v4"

# AES-256-GCM key (base64, 32 bytes) used to encrypt Session Vault secrets at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_VAULT_KEY=""

# Desk access gate (single shared secret for the whole desk in v1).
DESK_AUTH_SECRET=""

# Gemini vision for Sidekick identify (photos / auction lots). Never invent prices here.
# Free-tier keys often return limit:0 — enable Cloud Billing on the GCP project, then
# create a NEW key at https://aistudio.google.com/apikey (usually starts with AIza…).
# Do not commit real keys.
GEMINI_API_KEY=""
GEMINI_APPRAISE_MODEL="gemini-2.0-flash"
# Optional paid/fallback models: gemini-2.5-flash, gemini-2.5-flash-lite

# OpenAI vision fallback when Gemini quota fails (recommended while fixing billing).
# OPENAI_API_KEY=""
# OPENAI_IDENTIFY_MODEL="gpt-4o-mini"
# IDENTIFY_PROVIDER=auto   # auto | gemini | openai

# ---- Deal-desk defaults (dollars / percent). Overridable per request. ----
DEAL_TARGET_PROFIT="50"
DEAL_MIN_MARGIN_PCT="15"
DEAL_DEFAULT_BUYER_PREMIUM_PCT="18"
DEAL_DEFAULT_LISTING_UPGRADE="3"
# Legacy single default; API uses category ship when outboundShip is omitted:
# handgun/pistol $45, rifle/shotgun $60 (see src/lib/arbitrage/shipping.ts).
DEAL_DEFAULT_OUTBOUND_SHIP="30"
