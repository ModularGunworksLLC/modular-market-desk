# Your wholesale sites — copy to sites.local.yaml and add logins.
# NEVER commit sites.local.yaml
#
#   copy sites.local.yaml.example sites.local.yaml
#
# MFA sites: python -m mmd_engine.cli.auth <site_id>
# Status:    python -m mmd_engine.cli.credentials_cmd
# Age gates: auto-clicked; optional per site: age_gate_yes: "button#enter"

sites:
  # --- Primary firearms wholesalers (enable + fill credentials) ---
  # https://www.lipseys.com/login
  lipseys:
    enabled: true
    username: ""
    password: ""

  # https://shop2.gzanders.com/customer/account/login/... (not zanders.com)
  zanders:
    enabled: true
    username: ""
    password: ""

  # https://www.davidsonsinc.com/customer/account/login/...
  davidsons:
    enabled: false
    username: ""
    password: ""

  sports_south:
    enabled: false
    username: ""
    password: ""

  second_amendment:
    enabled: false
    username: ""
    password: ""

  orion:
    enabled: false
    username: ""
    password: ""

  # https://chattanoogashooting.com/login
  chattanooga:
    enabled: false
    username: ""
    password: ""

  primary_arms:
    enabled: false
    username: ""
    password: ""

  zro_delta:
    enabled: false
    username: ""
    password: ""

  lakeline:
    enabled: false
    username: ""
    password: ""

  # --- Gear / parts only (RSR = no firearms per your note) ---
  rsr:
    enabled: false
    username: ""
    password: ""
    # includes_firearms: false  # set in registry — gear only

  righttobear:
    enabled: false
    username: ""
    password: ""

  shootersgate:
    enabled: false
    username: ""
    password: ""

  bear_creek:
    enabled: false
    username: ""
    password: ""

  # --- Tools (optional) ---
  fflsafe:
    enabled: false
    username: ""
    password: ""

  guidefitter:
    enabled: false
    username: ""
    password: ""

  # --- Excluded — leave disabled (Kroll & Hicks = no go) ---
  kroll:
    enabled: false

  hicks:
    enabled: false

  # --- Public market (optional) ---
  gunbroker:
    enabled: false
    username: ""
    password: ""
