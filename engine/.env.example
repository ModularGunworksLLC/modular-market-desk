# --- Distributor / dealer portals ---
LIPSEYS_USER=
LIPSEYS_PASS=

ZANDERS_USER=
ZANDERS_PASS=

DAVIDSONS_USER=
DAVIDSONS_PASS=

SPORTS_SOUTH_USER=
SPORTS_SOUTH_PASS=

