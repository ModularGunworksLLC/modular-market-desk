# MMD_MAX_CSV_MB=200

# Live market pricing: Outdoor Analytics only (data/sessions/outdoor_analytics.json)
# Optional: MMD_OA_BEARER_TOKEN=...
# Legacy TrueGunValue/GunBroker/Gun.deals scrapers (not used on Lightsail):
# MMD_LEGACY_MARKET_SCRAPERS=1
MMD_NAV_TIMEOUT_MS=120000
MMD_NAV_WAIT_UNTIL=commit

MMD_BUYER_PREMIUM_PCT=18
MMD_AUCTION_FEES_PCT=18
MMD_GUNBROKER_LISTING_ADDONS=10
MMD_TARGET_PROFIT=75
