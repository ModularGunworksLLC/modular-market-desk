RSR_PASS=

# Optional — GunBroker account (public search works without login)
GUNBROKER_USER=
GUNBROKER_PASS=

# --- API security (set on public/hosted API) ---
MMD_API_KEY=

# --- Valuation defaults ---
MMD_AUCTION_FEES_PCT=13
MMD_TARGET_PROFIT=75

