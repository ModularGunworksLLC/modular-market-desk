# Distributor credentials (never commit .env)
# LIPSEYS_USER=
# LIPSEYS_PASS=
# ZANDERS_USER=
# ZANDERS_PASS=

# Live search API — required in production if the API is public
# MMD_API_KEY=generate-a-long-random-string

# Comma-separated origins for CORS (optional; API allows all by default)
# MMD_CORS_ORIGINS=http://localhost:5173,https://your-org.github.io
