# API — api.modulargunworks.com (Bitnami Apache)
# Does NOT modify ledger vhosts.
#
#   sudo cp deploy/apache-mmd-api.conf.example /opt/bitnami/apache/conf/vhosts/mmd-api.conf
#   sudo /opt/bitnami/ctlscript.sh restart apache
#
# TLS: use Bitnami bncert or certbot after DNS A record points here.

<VirtualHost 127.0.0.1:80 _default_:80>
  ServerName api.modulargunworks.com
  DocumentRoot /opt/bitnami/apps/letsencrypt
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/\.well-known
  RewriteRule ^ https://api.modulargunworks.com%{REQUEST_URI} [R=301,L]
</VirtualHost>

<VirtualHost 127.0.0.1:443 _default_:443>
  ServerName api.modulargunworks.com
  SSLEngine on
  SSLCertificateFile "/opt/bitnami/letsencrypt/certificates/api.modulargunworks.com.crt"
  SSLCertificateKeyFile "/opt/bitnami/letsencrypt/certificates/api.modulargunworks.com.key"
  Include "/opt/bitnami/apps/letsencrypt/conf/httpd-prefix.conf"
  ProxyPreserveHost On
  ProxyPass /.well-known !
  ProxyPass / http://127.0.0.1:8000/
  ProxyPassReverse / http://127.0.0.1:8000/
  ProxyTimeout 300
  <Location "/">
    Require all granted
  </Location>
</VirtualHost>
