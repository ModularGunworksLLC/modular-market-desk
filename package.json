{
  "name": "modular-market-desk",
  "version": "1.0.0",
  "private": true,
  "description": "High-speed firearm arbitrage desk: cross-references wholesaler catalogs and GunBroker Analytics market comps to deliver GO/NO-GO verdicts and a Max Bid threshold.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:init": "tsx scripts/init-db.ts",
    "db:web-comps": "tsx scripts/apply-web-comps-migration.ts",
    "test:gba": "tsx scripts/test-gba.ts",
    "oa:sync-catalog": "tsx scripts/sync-oa-catalog.ts",
    "oa:sync": "tsx scripts/sync-oa-full.ts",
    "tgv:sync": "tsx scripts/sync-tgv-gaps.ts",
    "flip:check": "tsx scripts/gba-flip-check.ts",
    "import:catalogs": "tsx scripts/import-catalogs.ts",
    "pearce:ai-resolve": "tsx scripts/ai-resolve-no-comps.mjs",
    "pearce:bid-pass": "node scripts/build-bid-pass-list.mjs",
    "pearce:buy-sheet": "node scripts/build-dealer-buy-sheet.mjs",
    "pearce:compare-oa": "tsx scripts/compare-pearce-to-oa-db.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "basic-ftp": "^6.0.2",
    "csv-parse": "^5.6.0",
    "drizzle-orm": "^0.38.3",
    "next": "^15.1.6",
    "nodemailer": "^9.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.2",
    "playwright": "^1.49.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
